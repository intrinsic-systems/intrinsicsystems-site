/* -------------------------------------------------
   CORE recovery layer — final layout control
------------------------------------------------- */

.o-core-shell {
  width: 100%;
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 10%, rgba(0, 135, 190, 0.16), transparent 32%),
    radial-gradient(circle at 88% 8%, rgba(68, 56, 180, 0.18), transparent 30%),
    #020d17;
}

.o-core-shell__content {
  width: 100%;
  box-sizing: border-box;
  padding: 24px 36px 56px;
}

.o-core-shell .o-workspace-frame {
  width: min(1760px, calc(100vw - 48px));
  max-width: none;
  margin: 0 auto;
  padding: 32px 36px;
  box-sizing: border-box;
  min-height: 0;
  height: auto;
  overflow: visible;
  background: linear-gradient(180deg, #f8fbff 0%, var(--oasis-workspace) 100%);
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: var(--oasis-radius-xl);
  box-shadow: var(--oasis-shadow-soft);
}

/* Pages */
.o-core-shell .o-page,
.o-core-shell .o-flow-page,
.o-core-shell .o-assessment-page,
.o-core-shell .o-results-page,
.o-core-shell .o-welcome-page {
  width: 100%;
  max-width: none;
  margin: 0;
}

/* Header */
.o-core-shell .o-page-header {
  margin-bottom: 28px;
}

/* Welcome + onboarding */
.o-core-shell .o-page-grid,
.o-core-shell .o-flow-layout,
.o-core-shell .o-page-grid--hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 28px;
  align-items: start;
  width: 100%;
}

/* Assessment landing */
.o-core-shell .o-assessment-home {
  width: 100%;
  max-width: none;
}

.o-core-shell .o-assessment-home__main {
  display: grid;
  gap: 16px;
  width: min(840px, 100%);
}

.o-core-shell .o-standards-card,
.o-core-shell .o-results-overview-card {
  width: 100%;
  max-width: none;
}

.o-core-shell .o-results-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

/* Active assessment */
.o-core-shell .o-assessment-workspace {
  width: min(1120px, 100%);
  margin: 0 auto;
}

.o-core-shell .o-sector-wizard-layout {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  gap: 20px;
}

.o-core-shell .o-assessment-main {
  display: block;
  min-height: 0;
}

.o-core-shell .o-assessment-body,
.o-core-shell .o-response-scale {
  width: 100%;
  max-width: none;
}

.o-core-shell .o-assessment-actions {
  position: static;
  margin-top: 18px;
  padding-top: 14px;
  background: transparent;
  border-top: 1px solid var(--oasis-border-subtle);
}

/* Footer + route actions */
.o-core-shell .o-core-footer {
  margin-top: 24px;
  padding-top: 12px;
  border-top: 1px solid var(--oasis-border-subtle);
  font-size: 11px;
  color: var(--oasis-text-muted);
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.o-core-shell .o-core-route-actions {
  justify-content: flex-end;
  margin-top: 18px;
}

/* Responsive */
@media (max-width: 1200px) {
  .o-core-shell .o-page-grid,
  .o-core-shell .o-flow-layout,
  .o-core-shell .o-page-grid--hero,
  .o-core-shell .o-sector-wizard-layout {
    grid-template-columns: 1fr;
  }

  .o-core-shell .o-results-summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .o-core-shell__content {
    padding: 18px 16px 32px;
  }

  .o-core-shell .o-workspace-frame {
    width: min(100%, calc(100vw - 16px));
    padding: 20px 16px;
    border-radius: 20px;
  }

  .o-core-shell .o-results-summary-grid {
    grid-template-columns: 1fr;
  }
}

/* -------------------------------------------------
   CORE final polish: sector wizard + onboarding
------------------------------------------------- */

.o-core-shell .o-workspace-frame {
  color: var(--oasis-text-primary);
}

/* Assessment workspace */
.o-core-shell .o-assessment-workspace {
  max-width: 1120px;
}

.o-core-shell .o-sector-wizard-layout {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  gap: 28px;
  align-items: start;
}

.o-core-shell .o-sector-wizard-aside {
  border-right: 1px solid rgba(43, 108, 176, 0.16);
  padding-right: 20px;
}

.o-core-shell .o-sector-wizard-aside ul {
  list-style: none;
  padding-left: 0;
  margin: 0;
}

.o-core-shell .o-area-item {
  list-style: none;
  margin: 0 0 8px;
}

.o-core-shell .o-area-button {
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 8px;
  min-height: 46px;
  padding: 9px 10px;
  border-radius: 10px;
  border: 1px solid rgba(43, 108, 176, 0.16);
  background: rgba(255, 255, 255, 0.76);
  color: var(--oasis-text-primary);
  text-align: left;
  cursor: pointer;
  box-shadow: 0 6px 14px rgba(24, 44, 82, 0.06);
}

.o-core-shell .o-area-button:hover {
  background: #f8fbff;
  border-color: rgba(43, 108, 176, 0.32);
}

.o-core-shell .o-area-button--active {
  background: linear-gradient(180deg, #dbeafe 0%, #eff6ff 100%);
  border-color: rgba(43, 108, 176, 0.48);
  box-shadow: 0 10px 22px rgba(43, 108, 176, 0.14);
}

.o-core-shell .o-area-button--complete {
  background: linear-gradient(180deg, #ecfdf5 0%, #e7fff4 100%);
}

.o-core-shell .o-area-button__copy {
  display: grid;
  gap: 1px;
}

.o-core-shell .o-area-code {
  font-size: 11px;
  font-weight: 800;
  line-height: 1.2;
}

.o-core-shell .o-area-name {
  font-size: 11px;
  line-height: 1.25;
}

.o-core-shell .o-area-progress,
.o-core-shell .o-area-current-question {
  font-size: 10px;
  color: var(--oasis-text-muted);
}

/* Question card */
.o-core-shell .o-question-card {
  border-radius: 16px;
  border: 1px solid rgba(43, 108, 176, 0.34);
  background: rgba(248, 251, 255, 0.92);
  box-shadow: 0 12px 28px rgba(24, 44, 82, 0.08);
  padding: 18px;
}

.o-core-shell .o-question-card__eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--oasis-accent);
  margin-bottom: 6px;
}

.o-core-shell .o-question-card__title {
  font-size: 16px;
  font-weight: 700;
  color: var(--oasis-text-primary);
}

/* Action strip should not turn into a white slab */
.o-core-shell .o-assessment-actions {
  background: transparent;
  border-top: 1px solid rgba(43, 108, 176, 0.14);
  padding-top: 18px;
}

.o-core-shell .o-assessment-actions__inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Onboarding intro cleanup */
.o-core-shell .o-flow-page .o-page-main > .o-card {
  background: rgba(255, 255, 255, 0.88);
}

@media (max-width: 1200px) {
  .o-core-shell .o-sector-wizard-layout {
    grid-template-columns: 1fr;
  }

  .o-core-shell .o-sector-wizard-aside {
    border-right: 0;
    padding-right: 0;
  }
}

/* -------------------------------------------------
   CORE final fix: SectorWizard left rail
------------------------------------------------- */

.o-core-shell .o-sector-wizard-layout {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  gap: 28px;
  align-items: start;
}

.o-core-shell .o-sector-wizard-aside {
  border-right: 1px solid var(--oasis-border-subtle);
  padding-right: 18px;
  min-width: 0;
}

.o-core-shell .o-assessment-profile-card {
  padding: 12px !important;
  margin-bottom: 16px;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid var(--oasis-border-subtle);
  border-radius: 14px;
  box-shadow: 0 8px 20px rgba(24, 44, 82, 0.08);
}

.o-core-shell .o-assessment-profile-card__eyebrow,
.o-core-shell .o-area-nav__eyebrow,
.o-core-shell .o-area-group__eyebrow {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--oasis-text-muted);
}

.o-core-shell .o-assessment-profile-card__title {
  font-size: 13px;
  font-weight: 700;
  color: var(--oasis-text-primary);
}

.o-core-shell .o-assessment-profile-card__meta {
  font-size: 11px;
  line-height: 1.35;
  color: var(--oasis-text-secondary);
}

.o-core-shell .o-sector-summary {
  margin-bottom: 18px;
}

.o-core-shell .o-sector-summary__label {
  font-size: 12px;
  color: var(--oasis-text-muted);
}

.o-core-shell .o-sector-summary__title {
  font-size: 18px;
  font-weight: 700;
  color: var(--oasis-text-primary);
}

.o-core-shell .o-sector-summary__meta {
  font-size: 12px;
  line-height: 1.45;
  color: var(--oasis-text-secondary);
}

.o-core-shell .o-area-nav {
  font-size: 13px;
}

.o-core-shell .o-area-list {
  list-style: none !important;
  padding-left: 12px !important;
  margin: 0 !important;
}

.o-core-shell .o-area-item {
  list-style: none !important;
  margin-bottom: 8px;
}

.o-core-shell .o-area-button {
  width: 100%;
  min-height: 48px;
  display: flex !important;
  align-items: flex-start;
  gap: 8px;
  padding: 9px 10px;
  border-radius: 10px;
  border: 1px solid rgba(43, 108, 176, 0.16);
  background: rgba(255, 255, 255, 0.78);
  color: var(--oasis-text-primary);
  text-align: left;
  box-shadow: 0 6px 14px rgba(24, 44, 82, 0.06);
}

.o-core-shell .o-area-button--active {
  background: linear-gradient(180deg, #dbeafe 0%, #eff6ff 100%);
  border-color: rgba(43, 108, 176, 0.46);
}

.o-core-shell .o-area-button--complete {
  background: rgba(236, 253, 245, 0.92);
}

.o-core-shell .o-area-button__copy {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.o-core-shell .o-area-code {
  font-size: 11px;
  font-weight: 800;
}

.o-core-shell .o-area-name {
  font-size: 11px;
  line-height: 1.3;
}

.o-core-shell .o-area-progress,
.o-core-shell .o-area-current-question {
  font-size: 10px;
  color: var(--oasis-text-muted);
}

@media (max-width: 1200px) {
  .o-core-shell .o-sector-wizard-layout {
    grid-template-columns: 1fr;
  }

  .o-core-shell .o-sector-wizard-aside {
    border-right: 0;
    padding-right: 0;
  }
}

/* HARD OVERRIDE — SectorWizard rail visual restoration */
.o-core-shell .o-sector-wizard-layout {
  grid-template-columns: 245px minmax(0, 760px) !important;
  gap: 26px !important;
  justify-content: center !important;
}

.o-core-shell .o-sector-wizard-aside {
  padding-right: 18px !important;
  border-right: 1px solid rgba(43, 108, 176, 0.18) !important;
}

.o-core-shell .o-assessment-profile-card {
  padding: 12px !important;
  margin-bottom: 18px !important;
  border-radius: 14px !important;
  background: rgba(255, 255, 255, 0.96) !important;
  box-shadow: 0 10px 22px rgba(24, 44, 82, 0.10) !important;
}

.o-core-shell .o-sector-summary__title {
  font-size: 17px !important;
  font-weight: 800 !important;
}

.o-core-shell .o-area-list {
  list-style: none !important;
  padding-left: 10px !important;
  margin: 0 !important;
}

.o-core-shell .o-area-item {
  list-style: none !important;
  margin: 0 0 8px !important;
}

.o-core-shell .o-area-button {
  width: 100% !important;
  min-height: 54px !important;
  padding: 10px 12px !important;
  border-radius: 11px !important;
  text-align: left !important;
  background: rgba(236, 253, 245, 0.92) !important;
  border: 1px solid rgba(16, 185, 129, 0.22) !important;
  box-shadow: 0 8px 18px rgba(24, 44, 82, 0.08) !important;
}

.o-core-shell .o-area-button--active {
  background: linear-gradient(180deg, #dff7f1 0%, #ccfbf1 100%) !important;
  border-color: rgba(14, 165, 233, 0.62) !important;
  box-shadow: 0 10px 22px rgba(14, 165, 233, 0.16) !important;
}

.o-core-shell .o-area-code {
  font-size: 12px !important;
  font-weight: 800 !important;
}

.o-core-shell .o-area-name {
  font-size: 11px !important;
  line-height: 1.3 !important;
}

.o-core-shell .o-area-progress {
  font-size: 10px !important;
  opacity: 0.78 !important;
}